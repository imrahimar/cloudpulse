PORT=5000
NODE_ENV=development

# Comma-separated allowlist in production, e.g. https://app.example.com
CORS_ORIGIN=

DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=cloudpulse
DATABASE_USER=cloudpulse
DATABASE_PASSWORD=cloudpulse

# Use a long random value before any shared/public deployment
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=7d

AZURE_KEY_VAULT_URL=
AZURE_STORAGE_ACCOUNT=
AZURE_STORAGE_CONNECTION=
AZURE_SERVICE_BUS_CONNECTION=
AZURE_APPINSIGHTS_KEY=
